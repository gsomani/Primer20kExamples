// ---- Active constraints for the Template design (clk + led) ----
IO_LOC "clk" H11;
IO_LOC "led" N16;
IO_PORT "clk" IO_TYPE=LVCMOS33;
IO_PORT "led" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ---- Full board reference (copied from Boards/TangPrimer20KDock.cst) ----
// Everything below is commented out. Uncomment the ports your top module uses.

// TangPrimer20KDock.cst : pin reference for Tang Primer 20K Dock (rev 3713), GW2A-LV18PG256C8/I7
// Source: dock schematic sheet 1 (net -> ball paired by position in the PDF), plus H11 clock from the core board.
// Format per line: IO_LOC "port" BALL;   // net, IO name, bank
// Everything is commented out. Copy or uncomment only the ports your top module has,
// then add one IO_PORT line per used port, e.g.:
//   IO_PORT "led2" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// Bank VCCIO is set on the core/dock boards and is NOT in this PDF: confirm it matches IO_TYPE.
// Pins marked 'shared' are wired to more than one peripheral; do not use both at once.

// ---- Clock (core board, not in the dock PDF) ----
// IO_LOC "clk" H11;       // 27 MHz oscillator on the core board (not in the dock PDF)

// ---- User LEDs: active low (+3V3 -> LED -> 510R -> pin); drive 0 to light ----
// IO_LOC "led0" C13;       // Orange_LED0  (shared with DONE, config pin), IOR32B, bank 3
// IO_LOC "led1" A13;       // Orange_LED1  (shared with READY, config pin), IOR31A, bank 3
// IO_LOC "led2" N16;       // Orange_LED2, IOT52A, bank 1
// IO_LOC "led3" N14;       // Orange_LED3, IOT52B, bank 1
// IO_LOC "led4" L14;       // Orange_LED4, IOT34B, bank 1
// IO_LOC "led5" L16;       // Orange_LED5, IOT34A, bank 1

// ---- Push keys (silicone): idle high via 10K to 3V3/1V5, pressed = low (check pull-up rail on sheet 9) ----
// IO_LOC "key1" T10;       // Silicone Key_1  (shared with FPGA_RST, careful), IOR35B, bank 3
// IO_LOC "key2" T3;        // Silicone Key_2, IOB52B, bank 4
// IO_LOC "key3" T2;        // Silicone Key_3, IOB48B, bank 4
// IO_LOC "key4" D7;        // Silicone Key_4, IOL53B, bank 4
// IO_LOC "key5" C7;        // Silicone Key_5, IOL40B, bank 4

// ---- DIP switch SW3 (nets SW1..SW5 on sheet 1 = SW_01..SW_05 on sheet 9) ----
// IO_LOC "sw1" B10;        // SW1  (shared with RECFG, config pin), IOR31B, bank 3
// IO_LOC "sw2" E9;         // SW2, IOL38B, bank 4
// IO_LOC "sw3" E8;         // SW3, IOL45B, bank 4
// IO_LOC "sw4" T4;         // SW4, IOB45B, bank 4
// IO_LOC "sw5" T5;         // SW5, IOB54B, bank 4

// ---- BL702 USB-UART bridge (names are from the BL702 side) ----
// IO_LOC "uartTx" M11;     // FPGA TX -> BL702_UART1_RX, IOR27B, bank 2
// IO_LOC "uartRx" T13;     // FPGA RX <- BL702_UART1_TX, IOR8B, bank 2

